programa fibonnaciEnFuncion;

nula fibonacci(n: entero) {
    vars a, b, temp, i : entero;
    {
        a = 0;
        b = 1;
        i = 0;

        mientras (i < n) haz
        {
            escribe(a);
            temp = a + b;
            a = b;
            b = temp;
            i = i + 1;
        };
    }
};

inicio
{
    escribe("Serie Fibonacci (8 terminos):");
    fibonacci(8);
}
fin
